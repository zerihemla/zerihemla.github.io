<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ resume.name }} — {{ resume.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="static/css/style.css">
<script>
  // Set theme before paint to avoid a flash of the wrong theme.
  (function () {
    var saved = localStorage.getItem('site-theme');
    document.documentElement.setAttribute('data-theme', saved === 'terminal' ? 'terminal' : 'normal');
  })();
</script>
</head>
<body>

<div class="mode-switch" role="group" aria-label="Site mode">
  <button type="button" class="mode-btn" data-mode="normal">Normal</button>
  <button type="button" class="mode-btn" data-mode="terminal">Developer Mode</button>
</div>

<div class="trace-rail normal-only" aria-hidden="true"></div>

<header class="hero hero-normal normal-only">
  <div class="scope">
    <svg viewBox="0 0 600 120" class="scope-svg" aria-hidden="true">
      <polyline id="wave" fill="none" stroke="var(--accent-2)" stroke-width="2"
        points="0,60 40,60 55,20 70,100 85,60 140,60 155,30 170,90 185,60 260,60 275,15 290,105 305,60 400,60 415,35 430,85 445,60 600,60" />
    </svg>
  </div>
  <p class="eyebrow">// {{ resume.location }}</p>
  <h1>{{ resume.name }}</h1>
  <h2>{{ resume.title }}</h2>
  <p class="tagline">{{ resume.tagline }}</p>
  <div class="hero-links">
    {% if resume.github %}<a href="{{ resume.github }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
    {% if resume.linkedin %}<a href="{{ resume.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}
    <a href="mailto:{{ resume.email }}">{{ resume.email }}</a>
    {% if resume.phone %}<span class="hero-phone">{{ resume.phone }}</span>{% endif %}
  </div>
</header>

<header class="hero hero-terminal terminal-only">
  <div class="term-window hero-term">
    <div class="term-bar">
      <span class="dot dot-red"></span><span class="dot dot-yellow"></span><span class="dot dot-green"></span>
      <span class="term-title">guest@resume:~</span>
    </div>
    <div class="term-body">
      <p class="term-line"><span class="prompt">guest@resume</span><span class="prompt-path">:~$</span> whoami</p>
      <p class="term-output name-output">{{ resume.name }}</p>

      <p class="term-line"><span class="prompt">guest@resume</span><span class="prompt-path">:~$</span> cat role.txt</p>
      <p class="term-output">{{ resume.title }}</p>

      <p class="term-line"><span class="prompt">guest@resume</span><span class="prompt-path">:~$</span> cat motto.txt</p>
      <p class="term-output tagline">{{ resume.tagline }}</p>

      <p class="term-line"><span class="prompt">guest@resume</span><span class="prompt-path">:~$</span> ls contact/</p>
      <p class="term-output contact-output">
        // {{ resume.location }}<br>
        {% if resume.github %}<a href="{{ resume.github }}" target="_blank" rel="noopener">{{ resume.github }}</a><br>{% endif %}
        {% if resume.linkedin %}<a href="{{ resume.linkedin }}" target="_blank" rel="noopener">{{ resume.linkedin }}</a><br>{% endif %}
        <a href="mailto:{{ resume.email }}">{{ resume.email }}</a>{% if resume.phone %} · {{ resume.phone }}{% endif %}
      </p>
      <p class="term-line"><span class="prompt">guest@resume</span><span class="prompt-path">:~$</span> <span class="cursor">▊</span></p>
    </div>
  </div>
</header>

<main>

  {% macro chrome_open(file_name) %}
  <span class="node-dot normal-only" aria-hidden="true"></span>
  <div class="term-bar terminal-only">
    <span class="dot dot-red"></span><span class="dot dot-yellow"></span><span class="dot dot-green"></span>
    <span class="term-title">{{ file_name }}</span>
  </div>
  {% endmacro %}

  <section class="node" id="about">
    {{ chrome_open("about.sh") }}
    <div class="node-body">
      <h3 class="section-label"><span class="terminal-only">$ </span>ABOUT</h3>
      <p class="about-text">{{ resume.about|safe }}</p>
    </div>
  </section>

  <section class="node" id="skills">
    {{ chrome_open("stack.sh") }}
    <div class="node-body">
      <h3 class="section-label"><span class="terminal-only">$ </span>STACK</h3>
      <div class="skill-groups">
        {% for group in resume.skill_groups %}
        <div class="skill-group reveal">
          <p class="skill-group-label">{{ group.label }}</p>
          <div class="skill-chips">
            {% for item in group.skills %}
            <span class="chip">{{ item }}</span>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="node" id="projects">
    {{ chrome_open("projects.sh") }}
    <div class="node-body">
      <h3 class="section-label"><span class="terminal-only">$ </span>PROJECTS</h3>
      <div class="project-list">
        {% for p in resume.projects %}
        <article class="project-card reveal">
          <div class="project-header">
            <h4>{{ p.name }}</h4>
            <span class="status status-{{ p.status|lower|replace(' ', '-') }}">{{ p.status }}</span>
          </div>
          <p class="project-stack">{{ p.stack }}</p>
          <p class="project-desc">{{ p.description|safe }}</p>
          {% if p.link %}
          <a class="project-link" href="{{ p.link }}" target="_blank" rel="noopener">View Project →</a>
          {% endif %}
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="node" id="experience">
    {{ chrome_open("experience.log") }}
    <div class="node-body">
      <h3 class="section-label"><span class="terminal-only">$ </span>EXPERIENCE</h3>
      <div class="experience-list">
        {% for e in resume.experience %}
        <div class="experience-item reveal">
          <p class="exp-period">{{ e.period }}</p>
          <div class="exp-body">
            <h4>{{ e.role }} <span class="exp-org">— {{ e.org }}</span></h4>
            <p>{{ e.summary|safe }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if resume.education %}
  <section class="node" id="education">
    {{ chrome_open("education.sh") }}
    <div class="node-body">
      <h3 class="section-label"><span class="terminal-only">$ </span>EDUCATION</h3>
      <div class="experience-list">
        {% for ed in resume.education %}
        <div class="experience-item reveal">
          <p class="exp-period">{{ ed.period }}</p>
          <div class="exp-body">
            <h4>{{ ed.degree }} <span class="exp-org">— {{ ed.school }}</span></h4>
            {% if ed.detail %}<p>{{ ed.detail }}</p>{% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if resume.school_projects %}
  <section class="node" id="school-projects">
    {{ chrome_open("school_projects.sh") }}
    <div class="node-body">
      <h3 class="section-label"><span class="terminal-only">$ </span>SCHOOL PROJECTS</h3>
      <div class="project-list">
        {% for sp in resume.school_projects %}
        <article class="project-card reveal">
          <div class="project-header">
            <h4>{{ sp.name }}</h4>
            <span class="status status-school">{{ sp.purpose }}</span>
          </div>
          {% if sp.description %}<p class="project-desc">{{ sp.description|safe }}</p>{% endif %}
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if resume.interests %}
  <section class="node" id="interests">
    {{ chrome_open("interests.sh") }}
    <div class="node-body">
      <h3 class="section-label"><span class="terminal-only">$ </span>INTERESTS</h3>
      <div class="skill-groups">
        {% for group in resume.interests %}
        <div class="skill-group reveal">
          <p class="skill-group-label">{{ group.grouping|upper }}</p>
          <div class="skill-chips">
            {% for item in group.activities.split(', ') %}
            <span class="chip">{{ item }}</span>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

</main>

<footer>
  <p>{{ resume.name }} · built with Python + Jinja2 · hosted on GitHub Pages</p>
</footer>

<script src="static/js/main.js"></script>
<script src="static/js/theme.js"></script>
</body>
</html>
